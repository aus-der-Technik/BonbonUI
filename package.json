{
  "name": "@bonbon-ui/core",
  "version": "1.0.1",
  "description": "Svelte 5 + TypeScript component library (atomic design) for modern web applications.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!dist/**/*.mdx",
    "!dist/demo",
    "!dist/foundations",
    "!dist/test"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "svelte": "./dist/map.js",
      "default": "./dist/map.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "npm run typecheck && svelte-package --input src/lib --output dist && publint",
    "prepare": "svelte-package --input src/lib --output dist",
    "storybook": "storybook dev -p 6006",
    "storybook:ci": "storybook dev -p 6006 --no-open --ci",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/svelte-vite": "^10.5.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/leaflet": "^1.9.12",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.3",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.12",
    "storybook": "^10.5.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  }
}
